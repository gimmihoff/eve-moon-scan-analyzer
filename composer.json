{
  "name": "gimmihoff/eve-moon-scan-analyzer",
  "description": "Modern RESTful moon scan analyzer for Eve Online",
  "type": "project",
  "license": "Apache-2.0",
  "keywords": [
    "eve-online",
    "moon-scanning",
    "api",
    "laminas"
  ],
  "homepage": "https://github.com/gimmihoff/eve-moon-scan-analyzer",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-json": "*",
    "laminas/laminas-mvc": "^3.5",
    "laminas/laminas-router": "^2.7",
    "laminas/laminas-http": "^2.18",
    "laminas/laminas-form": "^3.2",
    "laminas/laminas-inputfilter": "^2.18",
    "laminas/laminas-filter": "^2.18",
    "laminas/laminas-validator": "^2.27",
    "laminas/laminas-session": "^2.18",
    "laminas/laminas-authentication": "^2.16",
    "laminas/laminas-permissions-rbac": "^3.4",
    "laminas/laminas-log": "^2.16",
    "laminas/laminas-cache": "^3.4",
    "laminas/laminas-serializer": "^2.13",
    "laminas/laminas-json": "^3.3",
    "doctrine/orm": "^2.15",
    "doctrine/dbal": "^3.7",
    "doctrine/migrations": "^3.7",
    "doctrine/doctrine-orm-module": "^5.3",
    "firebase/php-jwt": "^6.8",
    "guzzlehttp/guzzle": "^7.7",
    "league/oauth2-client": "^2.7",
    "nesbot/carbon": "^2.72",
    "monolog/monolog": "^3.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "squizlabs/php_codesniffer": "^3.8",
    "laminas/laminas-development-mode": "^3.11",
    "laminas/laminas-cli": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/Application/",
      "Infrastructure\\": "src/Infrastructure/",
      "Domain\\": "src/Domain/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AppTest\\": "tests/Application/",
      "InfrastructureTest\\": "tests/Infrastructure/",
      "DomainTest\\": "tests/Domain/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public/ public/index.php",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage/",
    "cs-check": "phpcs src/ tests/",
    "cs-fix": "phpcbf src/ tests/",
    "stan": "phpstan analyse src/",
    "lint": "@cs-check && @stan"
  }
}
