                <a href="/api/moons/list">Moon List</a>
                <a href="/api/scans/list">Scan History</a>
            </div>
            <div class="login-box">
                <?php if (!empty($user)): ?>
                    <span>Logged in as <strong><?= htmlspecialchars($user['character_name']) ?></strong></span>
                    <a href="/auth/logout" class="button secondary" style="text-decoration:none; display:inline-block;">Logout</a>
                <?php else: ?>
                    <a href="/auth/login" class="button primary" style="text-decoration:none; display:inline-block;">EVE SSO Login</a>
                <?php endif; ?>
            </div>
        </header>

        <?php if (!empty($auth_error)): ?>
            <div class="panel" style="margin-bottom:20px;">
                <div class="status error"><?= htmlspecialchars($auth_error) ?></div>
            </div>
        <?php endif; ?>

        <section class="grid">
            <div class="panel">
                <h2>Paste moon scan data</h2>
                <textarea id="scanInput" placeholder="40000001\tTitanium Chromide\t123.456">40000001\tTitanium Chromide\t123.456
40000002\tTwisted Exergite\t654.321
40000003\tChromebit\t800.0</textarea>
                <div class="helper">Format: Moon ID → Material Name → Quantity. One row per material item.</div>
                <div class="button-row">
                    <button class="button primary" id="analyzeBtn">Analyze scan</button>
                    <button class="button secondary" id="sampleBtn">Load sample</button>
                </div>
                <div id="status" class="status"></div>
            </div>

            <aside class="panel">
                <h2>Quick stats</h2>
                <div class="stats">
                    <div class="stat">
                        <div class="stat-label">Moons</div>
                        <div class="stat-value" id="statMoons">0</div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">Materials</div>
                        <div class="stat-value" id="statMaterials">0</div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">ISK</div>
                        <div class="stat-value" id="statIsk">0</div>
                    </div>
                </div>
            </aside>
        </section>

        <section id="resultsSection" class="panel results-wrap">
            <h2>Analysis results</h2>
            <div id="results"></div>
        </section>
    </div>

    <script>
        const scanInput = document.getElementById('scanInput');
        const analyzeBtn = document.getElementById('analyzeBtn');
        const sampleBtn = document.getElementById('sampleBtn');
        const statusEl = document.getElementById('status');
        const resultSection = document.getElementById('resultsSection');
        const resultsEl = document.getElementById('results');
        const statMoons = document.getElementById('statMoons');
        const statMaterials = document.getElementById('statMaterials');
        const statIsk = document.getElementById('statIsk');

        sampleBtn.addEventListener('click', () => {
            scanInput.value = '40000001\tTitanium Chromide\t123.456\n40000001\tTwisted Exergite\t654.321\n40000002\tChromebit\t800.0\n40000003\tLustering Alloy\t245.1';
            statusEl.textContent = 'Sample data loaded.';
            statusEl.className = 'status success';
        });

        analyzeBtn.addEventListener('click', async () => {
            const raw = scanInput.value.trim();
            if (!raw) {
                statusEl.textContent = 'Please paste some scan data first.';
                statusEl.className = 'status error';
                return;
            }

            statusEl.textContent = 'Analyzing scan...';
            statusEl.className = 'status';

            try {
                const response = await fetch('/api/upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ scan_data: raw, submitted_by: 'web-ui' })
                });
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.error || 'Unknown error');
                }
                renderResults(data);
                statusEl.textContent = 'Scan analyzed successfully.';
                statusEl.className = 'status success';
            } catch (error) {
                statusEl.textContent = error.message || 'Failed to analyze scan.';
                statusEl.className = 'status error';
            }
        });

        function numberFormat(value) {
            return new Intl.NumberFormat('en-US', { maximumFractionDigits: 2, minimumFractionDigits: 0 }).format(value || 0);
        }

        function renderResults(data) {
            const moons = data.moons || {};
            const moonKeys = Object.keys(moons);
            const totalMaterials = moonKeys.reduce((sum, key) => sum + (moons[key] || []).length, 0);
            let totalIsk = 0;
            for (const moonKey of moonKeys) {
                const entries = moons[moonKey] || [];
                for (const item of entries) {
                    totalIsk += (item.quantity || 0) * (item.unit_price || 0);
                }
            }

            statMoons.textContent = String(moonKeys.length);
            statMaterials.textContent = String(totalMaterials);
            statIsk.textContent = numberFormat(totalIsk);

            let html = `
                <div class="badge">${data.moon_count || moonKeys.length} moons processed</div>
                <div class="muted" style="margin-top:12px;">Scan ID: <strong>${data.scan_id || 'n/a'}</strong></div>
            `;

            for (const moonKey of moonKeys) {
                const entries = moons[moonKey] || [];
                const moonTotal = entries.reduce((sum, item) => sum + (item.quantity || 0) * (item.unit_price || 0), 0);
                html += `<h3 style="margin-top:24px;">Moon ${moonKey}</h3><table><thead><tr><th>Material</th><th>Quantity</th><th>Unit price</th><th>Value</th></tr></thead><tbody>`;
                for (const item of entries) {
                    html += `<tr><td>${item.name || 'Unknown material'}</td><td>${numberFormat(item.quantity || 0)}</td><td>${numberFormat(item.unit_price || 0)}</td><td>${numberFormat((item.quantity || 0) * (item.unit_price || 0))}</td></tr>`;
                }
                html += `</tbody></table><div class="muted" style="margin-top:10px;">Moon total value: <strong>${numberFormat(moonTotal)} ISK</strong></div>`;
            }

            resultsEl.innerHTML = html;
            resultSection.classList.add('visible');
        }
    </script>
</body>
</html>
